{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cafe-commerce",
  "compatibility_date": "2025-01-01",
  "main": "src/index.ts",
  "migrations": [
    {
      "tag": "v1",
      "new_sql": "migrations/0001_init.sql"
    },
    {
      "tag": "v2",
      "new_sql": "migrations/0002_seed.sql"
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "cafe-db",
      "database_id": "local-dev-db-id"
    }
  ],
  "r2_buckets": [
    {
      "binding": "PRODUCT_IMAGES",
      "bucket_name": "cafe-product-images"
    }
  ]
}
