{
  "name": "cafe-commerce",
  "private": true,
  "version": "1.0.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:web": "npm run dev --workspace apps/web",
    "dev:api": "npm run dev --workspace apps/api",
    "dev": "concurrently \"npm run dev:api\" \"npm run dev:web\"",
    "build:web": "npm run build --workspace apps/web",
    "build:api": "npm run build --workspace apps/api",
    "build": "npm run build:api && npm run build:web",
    "check:web": "npm run check --workspace apps/web",
    "check": "npm run check:web && npm run build:api",
    "test:api": "npm run test --workspace apps/api",
    "test:web": "npm run test --workspace apps/web",
    "test": "npm run test:api && npm run test:web",
    "backup": "npx tsx scripts/backup-db.mjs",
    "deploy:api": "npx wrangler deploy --config infra/cloudflare/wrangler.jsonc",
    "deploy:web": "npx wrangler pages deploy apps/web/.svelte-kit/output/client --project-name cafe-commerce",
    "deploy:d1": "npx wrangler d1 migrations apply cafe-db --remote --config infra/cloudflare/wrangler.jsonc"
  },
  "devDependencies": {
    "concurrently": "^9.0.1"
  },
  "description": "Dự án này là khởi đầu cho hệ thống bán café với:\r - Frontend: Svelte + Vite\r - Backend: Node.js + Express\r - Database: Cloudflare D1\r - Lưu trữ ảnh: Cloudflare R2\r - Kiến trúc mobile-first cho người dùng mua hàng và quản trị",
  "main": "index.js",
  "directories": {
    "doc": "docs"
  },
